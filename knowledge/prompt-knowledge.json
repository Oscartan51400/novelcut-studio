      "name": "讽刺反转",
      "priority": 88,
      "labels": ["抢功", "讽刺", "误会", "功劳归错", "被误解", "无所谓", "注意力转移", "焦点转到", "真正贡献者离开", "背景人物离开"],
      "minimumMatches": 1,
      "direction": "同时保留真实贡献者和被关注者的空间关系，用焦点、遮挡或走位完成反转，不额外解释。",
      "promptSkeleton": "真实结果仍在画面 → 注意力被错误对象吸引 → 焦点或人群转移 → 真正贡献者安静离开。",
      "referencePriority": ["character_view", "scene_view"],
      "continuityChecks": ["前后景关系", "焦点转移", "人群朝向", "真实贡献者出画方向"]
    },
    {
      "id": "emotional_resolution",
      "name": "情绪收束与伏笔",
      "priority": 85,
      "labels": ["主题句", "构图呼应", "回照", "情绪收束", "归家", "下一集伏笔", "伏笔", "切黑", "尾声"],
      "minimumMatches": 1,
      "direction": "先完成本集情绪收束，再只留一个独立、短促的下一集异常信号。",
      "promptSkeleton": "与开场呼应的稳定构图 → 主角完成主题动作或台词 → 停顿 → 单一伏笔出现并切黑。",
      "referencePriority": ["character_view", "scene_view", "prop"],
      "continuityChecks": ["与开场构图关系", "最终服装与道具", "主题台词口型", "伏笔独立性"]
    },
    {
      "id": "suspense_clue",
      "name": "悬疑线索揭示",
      "priority": 84,
      "labels": ["线索", "秘密", "证据", "真相", "照片", "录音", "监控", "门后", "发现异常"],
      "minimumMatches": 1,
      "direction": "先让线索处于部分遮蔽或错误理解中，再通过人物动作逐步显露一个可辨认信息。",
      "promptSkeleton": "正常观察 → 细节异常 → 人物接近或操作 → 单一线索被看清 → 反应停顿。",
      "referencePriority": ["prop", "character_view", "scene_view"],
      "continuityChecks": ["线索原位置", "持有人", "揭示顺序", "人物视线", "信息只展示一个重点"]
    },
    {
      "id": "romantic_tension",
      "name": "情感靠近",
      "priority": 80,
      "labels": ["心动", "暧昧", "告白", "牵手", "拥抱", "靠近", "亲吻", "避开视线"],
      "minimumMatches": 1,
