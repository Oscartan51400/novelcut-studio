      "priority": 88,
      "labels": ["打斗", "交手", "挥拳", "格挡", "踢击", "攻击", "反击", "闪避"],
      "minimumMatches": 2,
      "direction": "一镜只表现一次清楚的攻防交换，写清攻击者、接触点、防守反应和最终站位。",
      "promptSkeleton": "双方初始架势 → 单次攻击 → 格挡或闪避 → 反作用与新站位。",
      "referencePriority": ["character_view", "scene_view", "prop"],
      "continuityChecks": ["攻击者", "武器所在手", "接触点", "轴线", "动作后站位"]
    },
    {
      "id": "horror_threat",
