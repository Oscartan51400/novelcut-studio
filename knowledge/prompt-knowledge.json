    "defaultShotSize": {
      "character": "中景，人物动作和手部关系清楚",
      "emotion": "近景，面部表情与眼神清楚",
      "dialoguePair": "双人中景，保持双方轴线与视线关系",
      "environment": "全景，先建立主体与环境的空间关系"
    },
    "defaultCamera": "固定机位，构图稳定，不自行增加复杂运镜",
    "timelineRatios": [0.2, 0.8],
    "constraints": {
      "basePositive": [
        "动作连续且符合惯性",
        "主体结构自然",
        "焦点稳定并服务于核心动作"
      ],
      "characterPositive": [
        "人物身份、五官、发型和服装全程锁定",
        "表演以可见的眼神、呼吸、手部和姿态变化呈现"
      ],
      "scenePositive": [
        "场景布局、时间、天气和主光方向连续"
      ],
      "negative": [
        "不出现字幕",
        "不出现 Logo 或水印",
        "不增加未指定人物或道具"
      ],
      "maxNegativeItems": 4
    }
  },
