      "minimumMatches": 1,
      "direction": "先明确权力关系和空间距离，再只保留一次情绪升级与一个明确后果。",
      "promptSkeleton": "对峙站位 → 一方施压或质问 → 另一方反应或反击 → 关系后果落点。",
      "referencePriority": ["character_view", "scene_view", "prop"],
      "continuityChecks": ["人物轴线", "谁掌控空间", "情绪强度", "道具归属", "离开方向"]
    },
