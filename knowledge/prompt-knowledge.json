{
  "meta": {
    "name": "NovelCut 短剧镜头知识库",
    "version": "2026.09.18-3",
    "updatedAt": "2026-09-18",
    "language": "zh-CN",
    "purpose": "把上传分镜转换为更明确、可检查、适合 Seedance 2.0 逐镜生成的执行指令。",
    "principles": [
      "保留创作者原意，只补齐缺失的镜头执行信息，不擅自扩写剧情。",
      "主体与核心动作优先，装饰性风格词靠后。",
      "一个镜头只保留一个主运镜；短时长只承载一个主要动作结果。",
      "人物、服装、关键道具、场景地理、时间与光向属于跨镜连续性锚点。",
      "约束保持少而具体，优先使用正向可执行描述。",
      "身份参考、服装状态、空间基准、逐镜视角和首尾帧必须各自承担单一职责，避免参考图之间互相污染。",
      "先锁定世界坐标、人物调度和动作终点，再选择景别、机位和镜头运动。"
    ]
  },
  "compiler": {
    "fieldOrder": [
      "subject",
      "action",
      "scene",
      "camera",
      "timeline",
      "lighting",
      "style",
      "audio",
      "constraints"
