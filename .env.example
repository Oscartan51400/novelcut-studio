PORT=5188
HOST=127.0.0.1

# Volcengine Ark / Seedance
ARK_BASE_URL=https://ark.cn-beijing.volces.com
SEEDANCE_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0-pro-260128
SEEDANCE_RESOLUTION=720p
SEEDANCE_SUBMIT_PATH=/api/v3/contents/generations/tasks
SEEDANCE_STATUS_PATH=/api/v3/contents/generations/tasks
# 资产生图默认复用 SEEDANCE_API_KEY；如需单独密钥可配置 SEEDREAM_API_KEY。
SEEDREAM_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-260128
SEEDREAM_SIZE=2k

# Optional. During local migration NovelCut can read the existing Zaojing .env.
# NOVELCUT_SHARED_ENV=../../zaojing-ai-canvas/.env

FFMPEG_PATH=ffmpeg
